<button type="button" id="pdf-reader">Read PDF</button>
<a href="/story.pdf">Open original PDF</a>
<script>
  import Flippy from 'flippypdf';
  let viewer: Flippy | undefined;
  document.querySelector('#pdf-reader')?.addEventListener('click', () => {
    viewer ||= new Flippy({ pdfUrl: '/story.pdf', mode: 'book' });
    viewer.open().catch(console.error);
  });
  document.addEventListener('astro:before-swap', () => { viewer?.destroy(); });
</script>
