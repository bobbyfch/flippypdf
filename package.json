{
  "name": "flippypdf",
  "version": "2.1.0",
  "description": "Framework-independent PDF flipbook with lazy PDF.js loading",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bobbyfch/flippypdf.git"
  },
  "main": "./dist/js/flippy.esm.js",
  "module": "./dist/js/flippy.esm.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/js/flippy.esm.js",
      "default": "./dist/js/flippy.esm.js"
    },
    "./css": "./dist/css/flippy.min.css",
    "./vue": "./adapters/vue/FlippyViewer.vue",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "adapters",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "test:types": "tsc -p tests/types/tsconfig.json",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "pdfjs-dist": "4.10.38",
    "typescript": "5.9.3",
    "vue": "3.5.43"
  }
}
